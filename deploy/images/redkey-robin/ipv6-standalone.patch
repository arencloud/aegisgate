+func TestStandaloneNodeStatusIPv6(t *testing.T) {
+	for _, tc := range []struct{ address, ip string }{
+		{"10.0.0.1:6379", "10.0.0.1"},
+		{"[fd01:200::1]:6379", "fd01:200::1"},
+	} {
+		cfg := testStandaloneConfig(redisv1.ClusterStatusReady, 1)
+		c := fake.NewClientBuilder().WithScheme(clusterTestScheme).WithObjects(cfg).WithStatusSubresource(cfg).Build()
+		cr := &ClusterReconciler{client: c, clusterName: "test-cluster"}
+		if err := cr.updateStandaloneNodeStatus(context.Background(), cfg, tc.address); err != nil {
+			t.Fatal(err)
+		}
+		if got := cfg.Status.Nodes["test-cluster-0"].IP; got != tc.ip {
+			t.Fatalf("got %q, want %q", got, tc.ip)
+		}
+	}
+}
